{
  "name": "tlin-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:check": "node scripts/check-lint.mjs",
    "lint:baseline": "node scripts/check-lint.mjs --update-baseline",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
