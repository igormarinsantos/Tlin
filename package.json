    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.11.0",
    "next": "16.3.5",
    "nodemailer": "10.0.10",
    "ogl": "^1.0.11",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "0.35.4",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
